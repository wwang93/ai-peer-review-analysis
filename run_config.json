      ],
      "english": [
        "Research understanding and critique",
        "Answer elaboration and task demands",
        "Limited benefit and writing reflection",
        "Questioning and self-checking"
      ],
      "selection_reason": "K=4 preserves a strategy-oriented topic missing in K=3 without the further splitting of generic better-understanding wording at K=5. Coherence is weak, so these are tentative prompts for semantic review. Comparable questions exist only for Rounds 1-3."
    },
    "RQ3_extended": {
      "labels": [
        "提问与引导策略",
        "研究理解与解释",
        "收获评价与情绪挑战（混合）",
