      "english": [
        "Research detail and explanation",
        "Language edits and limited change",
        "Expanding or checking answers"
      ],
      "selection_reason": "K=3 retained as a broad navigation model. K>=4 isolates repeated phrasing dominated by one participant rather than a clear new revision action. Human coding must separate reported actual edits, plans, no change, and independent revision."
    },
    "RQ3": {
      "labels": [
        "研究理解与批判性解释",
        "回答展开与任务要求意识",
